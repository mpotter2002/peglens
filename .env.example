# Optional. Hermes /v2/updates/price/latest requires a Pyth API key
# since the Aug 2026 Core upgrade. Without it, xStockLens uses the public
# Pyth Terminal snapshot plus Hermes feed metadata (market hours, ids).
# Get a key at https://app.pyth.com — never commit it.
PYTH_API_KEY=

# Optional override. Default: https://hermes.pyth.network
PYTH_HERMES_URL=https://hermes.pyth.network
